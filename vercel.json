{
  "trailingSlash": true,
  "regions": ["arn1"],
  "functions": {
    "api/larsito-*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/norsk-activar/", "destination": "/api/norsk-comercial?route=activar" },
    { "source": "/api/norsk-checkout/", "destination": "/api/norsk-comercial?route=checkout" },
    { "source": "/api/norsk-gracias/", "destination": "/api/norsk-comercial?route=gracias" },
    { "source": "/api/norsk-reenviar/", "destination": "/api/norsk-comercial?route=reenviar" },
    { "source": "/api/norsk-webhook/", "destination": "/api/norsk-comercial?route=webhook" }
  ],
  "redirects": [
    { "source": "/norsk/app/app.js", "destination": "/pass/app/app.js", "permanent": true },
    { "source": "/norsk/app/", "destination": "/pass/app/", "permanent": true },
    { "source": "/norsk/acceso/", "destination": "/pass/acceso/", "permanent": true },
    { "source": "/norsk/gracias/", "destination": "/pass/gracias/", "permanent": true },
    { "source": "/norsk/leccion-0/", "destination": "/pass/leccion-0/", "permanent": true },
    { "source": "/norsk/preguntas-de-ejemplo/", "destination": "/pass/preguntas-de-ejemplo/", "permanent": true },
    { "source": "/norsk/que-examen-necesitas/", "destination": "/pass/que-examen-necesitas/", "permanent": true },
    { "source": "/norsk/como-inscribirse/", "destination": "/pass/como-inscribirse/", "permanent": true },
    { "source": "/norsk/requisitos-ciudadania-noruega/", "destination": "/pass/requisitos-ciudadania-noruega/", "permanent": true },
    { "source": "/norsk/condiciones/", "destination": "/pass/condiciones/", "permanent": true },
    { "source": "/norsk/privacidad/", "destination": "/pass/privacidad/", "permanent": true }
  ]
}
